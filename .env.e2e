# Configuración para las pruebas de punta a punta (npm run test:e2e).
# No contiene secretos: las pruebas usan un Supabase simulado (e2e/soporte/supabase-falso.ts)
# y un mapa base vacío, así que no se conectan a ningún servicio real.
VITE_SUPABASE_URL=https://supabase-falso.e2e.local
VITE_SUPABASE_PUBLISHABLE_KEY=clave-publica-falsa
VITE_MAP_STYLE_URL_LIGHT=https://mapa-falso.e2e.local/claro.json
VITE_MAP_STYLE_URL_DARK=https://mapa-falso.e2e.local/oscuro.json
