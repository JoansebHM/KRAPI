# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a git.

# Estilos del mapa base (MapLibre) para modo claro y oscuro.
# Si el claro se deja vacío se usa OpenFreeMap Liberty (gratis, sin API key).
# Si el oscuro se deja vacío, se genera una versión nocturna a partir del claro,
# conservando los nombres de los locales.
# Ejemplo MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=TU_KEY
VITE_MAP_STYLE_URL_LIGHT=
VITE_MAP_STYLE_URL_DARK=

# --- Supabase ---
# URL del proyecto. No es secreta.
VITE_SUPABASE_URL=https://ggrwybqiqffoxuoojopp.supabase.co

# Clave secreta (Project Settings → API Keys → Secret key). Solo para scripts de administración.
# NUNCA le pongas el prefijo VITE_: todo lo que empieza por VITE_ termina visible en el navegador.
SUPABASE_SECRET_KEY=

# Correo del usuario compartido de Kratos (lo usa `npm run usuario:crear`).
KRAPI_USUARIO_EMAIL=
