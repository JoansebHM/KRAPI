{
  "name": "kira",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "docs": "node scripts/docs/generar.ts",
    "db:link": "supabase link --project-ref ggrwybqiqffoxuoojopp",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "mkdir -p src/types && supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:config": "supabase config push",
    "usuario:crear": "node --env-file=.env.local scripts/crear-usuario-compartido.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.3",
    "@dicebear/croodles": "^9.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
